{
  "name": "obsidian-annual-review",
  "version": "0.1.0",
  "description": "Local-first Obsidian plugin that generates editable annual review notes.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "ai:context-placeholder": "node scripts/obsidian-ai-context-placeholder.mjs",
    "deploy:plugin": "node scripts/deploy-plugin.mjs",
    "writing-growth": "node scripts/writing-growth-report.mjs",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "annual-review",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.12.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
