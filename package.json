{
  "name": "obsidian-annual-review",
  "version": "0.1.0",
  "description": "Local-first Obsidian plugin that generates editable annual review notes.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "dev:deploy-plugin": "node scripts/deploy-plugin.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release:check": "npm run release:plugin -- --skip-build && node scripts/check-release-artifact.mjs",
    "release:plugin": "node scripts/deploy-plugin.mjs --no-deploy",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "annual-review",
    "markdown"
  ],
  "author": "Timisic",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "obsidian": "^1.12.3",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
